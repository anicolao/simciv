#!/usr/bin/env bash
# SimCiv development environment management script
# Manages all development services using tmux for easy log access
#
# Usage: dev {start|stop|status|attach}

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# tmux session configuration
SESSION_NAME="simciv-dev"
WINDOW_MONGODB="mongodb"
WINDOW_SERVER="server"
WINDOW_ENGINE="engine"
WINDOW_VITE="vite"

# Port configuration
PORT_MONGODB=27017
PORT_SERVER=3000
PORT_ENGINE=3001
PORT_VITE=5173

# Timeout configuration (in seconds)
TIMEOUT_MONGODB=30
TIMEOUT_SERVER=30
TIMEOUT_ENGINE=10
TIMEOUT_VITE=30

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Helper functions
echo_success() {
    echo -e "${GREEN}✅ $1${NC}"
}

echo_error() {
    echo -e "${RED}❌ $1${NC}"
}

echo_warning() {
    echo -e "${YELLOW}⚠️  $1${NC}"
}

echo_info() {
    echo -e "${BLUE}ℹ️  $1${NC}"
}

echo_step() {
    echo -e "${BLUE}🔧 $1${NC}"
}

# Check if tmux is installed
check_tmux() {
    if ! command -v tmux >/dev/null 2>&1; then
        echo_error "tmux is not installed"
        echo "Please install tmux to use this script"
        exit 1
    fi
}

# Check if session exists
session_exists() {
    tmux has-session -t "$SESSION_NAME" 2>/dev/null
}

# Check if a port is in use
port_in_use() {
    local port=$1
    if command -v lsof >/dev/null 2>&1; then
        lsof -ti:$port >/dev/null 2>&1
    else
        # Fallback to netstat if lsof not available
        netstat -an | grep -q ":$port.*LISTEN" 2>/dev/null
    fi
}

# Get process using a port
get_port_process() {
    local port=$1
    if command -v lsof >/dev/null 2>&1; then
        lsof -ti:$port 2>/dev/null | head -1
    fi
}

# Wait for a port to be ready
wait_for_port() {
    local port=$1
    local timeout=$2
    local service=$3
    local count=0
    
    echo_step "Waiting for $service on port $port..."
    
    while ! port_in_use $port && [ $count -lt $timeout ]; do
        sleep 1
        count=$((count + 1))
    done
    
    if [ $count -ge $timeout ]; then
        echo_error "$service failed to start within ${timeout}s"
        return 1
    fi
    
    echo_success "$service is ready on port $port"
    return 0
}

# Wait for HTTP endpoint to be ready
wait_for_http() {
    local url=$1
    local timeout=$2
    local service=$3
    local count=0
    
    echo_step "Waiting for $service at $url..."
    
    while ! curl -s "$url" >/dev/null 2>&1 && [ $count -lt $timeout ]; do
        sleep 1
        count=$((count + 1))
    done
    
    if [ $count -ge $timeout ]; then
        echo_error "$service failed to respond within ${timeout}s"
        return 1
    fi
    
    echo_success "$service is responding at $url"
    return 0
}

# Check if required tools are available
check_prerequisites() {
    local missing=()
    
    if ! command -v node >/dev/null 2>&1; then
        missing+=("node")
    fi
    
    if ! command -v npm >/dev/null 2>&1; then
        missing+=("npm")
    fi
    
    if ! command -v go >/dev/null 2>&1; then
        missing+=("go")
    fi
    
    if [ ${#missing[@]} -gt 0 ]; then
        echo_error "Missing required tools: ${missing[*]}"
        echo "Please ensure all development tools are installed"
        exit 1
    fi
}

# Start command
cmd_start() {
    check_tmux
    check_prerequisites
    
    # Check if session already exists
    if session_exists; then
        echo_warning "Development session already exists"
        echo ""
        echo "Options:"
        echo "  1. Attach to existing session:  tmux attach -t $SESSION_NAME"
        echo "  2. Check status:                dev status"
        echo "  3. Stop and restart:            dev stop && dev start"
        echo ""
        read -p "Stop existing session and start fresh? (y/N): " response
        if [[ "$response" =~ ^[Yy]$ ]]; then
            cmd_stop
        else
            echo "Aborting. Use 'dev status' to check running services."
            exit 0
        fi
    fi
    
    echo ""
    echo "🎮 Starting SimCiv Development Environment"
    echo "=========================================="
    echo ""
    
    # Check for port conflicts
    local conflicts=()
    if port_in_use $PORT_SERVER; then
        conflicts+=("$PORT_SERVER (server)")
    fi
    if port_in_use $PORT_VITE; then
        conflicts+=("$PORT_VITE (vite)")
    fi
    
    if [ ${#conflicts[@]} -gt 0 ]; then
        echo_error "Port conflicts detected!"
        echo ""
        for conflict in "${conflicts[@]}"; do
            port=$(echo $conflict | cut -d' ' -f1)
            service=$(echo $conflict | cut -d' ' -f2)
            pid=$(get_port_process $port)
            echo "  Port $port $service is in use by PID: $pid"
        done
        echo ""
        echo "Please stop conflicting processes or use 'dev stop' if it's a previous session"
        exit 1
    fi
    
    # Ensure we're in the project root
    cd "$PROJECT_ROOT"
    
    # Check if node_modules exists
    if [ ! -d "node_modules" ]; then
        echo_warning "Node.js dependencies not installed"
        echo_step "Installing dependencies (this may take a moment)..."
        npm install
        echo_success "Dependencies installed"
        echo ""
    fi
    
    # Build TypeScript
    echo_step "Building TypeScript..."
    npm run build
    echo_success "Build complete"
    echo ""
    
    # Start MongoDB in first window
    echo_step "Starting MongoDB..."
    tmux new-session -d -s "$SESSION_NAME" -n "$WINDOW_MONGODB"
    tmux send-keys -t "$SESSION_NAME:$WINDOW_MONGODB" "cd '$PROJECT_ROOT' && '$SCRIPT_DIR/mongo' start && echo 'MongoDB started. Press Ctrl+C to stop.' && tail -f /dev/null" C-m
    
    # Wait a moment for mongo script to execute
    sleep 3
    
    # Verify MongoDB is running
    if ! port_in_use $PORT_MONGODB; then
        echo_error "MongoDB failed to start"
        echo "Check logs with: dev attach mongodb"
        tmux kill-session -t "$SESSION_NAME" 2>/dev/null || true
        exit 1
    fi
    echo_success "MongoDB started on localhost:$PORT_MONGODB"
    echo ""
    
    # Start Node.js server in second window
    echo_step "Starting Node.js server..."
    tmux new-window -t "$SESSION_NAME" -n "$WINDOW_SERVER"
    tmux send-keys -t "$SESSION_NAME:$WINDOW_SERVER" "cd '$PROJECT_ROOT' && npm run dev" C-m
    
    if ! wait_for_http "http://localhost:$PORT_SERVER" $TIMEOUT_SERVER "Node.js server"; then
        echo_error "Server failed to start"
        echo "Check logs with: dev attach server"
        cmd_stop
        exit 1
    fi
    echo ""
    
    # Start Go engine in third window
    echo_step "Starting Go simulation engine..."
    tmux new-window -t "$SESSION_NAME" -n "$WINDOW_ENGINE"
    
    # Check if engine needs to be built
    if [ ! -f "$PROJECT_ROOT/simulation/engine" ] || [ "$PROJECT_ROOT/simulation/pkg" -nt "$PROJECT_ROOT/simulation/engine" ]; then
        echo_step "Building Go engine..."
        tmux send-keys -t "$SESSION_NAME:$WINDOW_ENGINE" "cd '$PROJECT_ROOT/simulation' && go build -o engine main.go && ./engine" C-m
    else
        tmux send-keys -t "$SESSION_NAME:$WINDOW_ENGINE" "cd '$PROJECT_ROOT/simulation' && ./engine" C-m
    fi
    
    # Give engine a moment to start
    sleep 2
    
    # Check if engine is running
    if ! pgrep -f "./engine" >/dev/null 2>&1; then
        echo_error "Game engine failed to start"
        echo "Check logs with: dev attach engine"
        cmd_stop
        exit 1
    fi
    echo_success "Game engine started"
    echo ""
    
    # Start Vite dev server in fourth window
    echo_step "Starting Vite dev server..."
    tmux new-window -t "$SESSION_NAME" -n "$WINDOW_VITE"
    tmux send-keys -t "$SESSION_NAME:$WINDOW_VITE" "cd '$PROJECT_ROOT' && npm run dev:client" C-m
    
    if ! wait_for_http "http://localhost:$PORT_VITE" $TIMEOUT_VITE "Vite dev server"; then
        echo_error "Vite dev server failed to start"
        echo "Check logs with: dev attach vite"
        cmd_stop
        exit 1
    fi
    echo ""
    
    # Success!
    echo ""
    echo_success "SimCiv development environment is ready!"
    echo ""
    echo "Services running:"
    echo "  ✅ MongoDB        - localhost:$PORT_MONGODB"
    echo "  ✅ Server         - http://localhost:$PORT_SERVER"
    echo "  ✅ Game Engine    - Running (control server on :$PORT_ENGINE)"
    echo "  ✅ Vite          - http://localhost:$PORT_VITE"
    echo ""
    echo "To view logs:"
    echo "  dev attach mongodb   - View MongoDB logs"
    echo "  dev attach server    - View server logs"
    echo "  dev attach engine    - View engine logs"
    echo "  dev attach vite      - View Vite logs"
    echo ""
    echo "To view all services:"
    echo "  tmux attach -t $SESSION_NAME"
    echo ""
    echo "To stop all services:"
    echo "  dev stop"
    echo ""
    echo "To check status:"
    echo "  dev status"
    echo ""
}

# Stop command
cmd_stop() {
    if ! session_exists; then
        echo_success "No development services running"
        exit 0
    fi
    
    echo ""
    echo "🧹 Stopping SimCiv Development Environment"
    echo "==========================================="
    echo ""
    
    # Send Ctrl+C to each window in reverse order
    echo_step "Stopping Vite dev server..."
    tmux send-keys -t "$SESSION_NAME:$WINDOW_VITE" C-c 2>/dev/null || true
    
    echo_step "Stopping game engine..."
    tmux send-keys -t "$SESSION_NAME:$WINDOW_ENGINE" C-c 2>/dev/null || true
    
    echo_step "Stopping Node.js server..."
    tmux send-keys -t "$SESSION_NAME:$WINDOW_SERVER" C-c 2>/dev/null || true
    
    # Wait a moment for graceful shutdown
    sleep 2
    
    echo_step "Stopping MongoDB..."
    tmux send-keys -t "$SESSION_NAME:$WINDOW_MONGODB" C-c 2>/dev/null || true
    sleep 1
    
    # Kill the tmux session
    echo_step "Cleaning up tmux session..."
    tmux kill-session -t "$SESSION_NAME" 2>/dev/null || true
    
    # Wait for ports to be released
    sleep 2
    
    # Verify cleanup
    local still_running=()
    if port_in_use $PORT_SERVER; then
        still_running+=("Server (port $PORT_SERVER)")
    fi
    if port_in_use $PORT_VITE; then
        still_running+=("Vite (port $PORT_VITE)")
    fi
    if pgrep -f "./engine" >/dev/null 2>&1; then
        still_running+=("Game engine")
    fi
    
    if [ ${#still_running[@]} -gt 0 ]; then
        echo_warning "Some services didn't stop cleanly:"
        for service in "${still_running[@]}"; do
            echo "  - $service"
        done
        echo ""
        echo "You may need to manually kill these processes"
    else
        echo ""
        echo_success "All development services stopped"
    fi
    echo ""
}

# Status command
cmd_status() {
    echo ""
    echo "SimCiv Development Status"
    echo "========================="
    echo ""
    
    if ! session_exists; then
        echo_error "Development services not running"
        echo ""
        echo "Start with: dev start"
        exit 0
    fi
    
    echo "Session: $SESSION_NAME"
    local window_count=$(tmux list-windows -t "$SESSION_NAME" 2>/dev/null | wc -l)
    echo_success "Active ($window_count windows)"
    echo ""
    
    echo "Services:"
    
    # Check MongoDB
    if port_in_use $PORT_MONGODB; then
        echo_success "MongoDB       - Running on localhost:$PORT_MONGODB"
    else
        echo_error "MongoDB       - Not running"
    fi
    
    # Check Server
    if curl -s http://localhost:$PORT_SERVER >/dev/null 2>&1; then
        echo_success "Server        - Running on http://localhost:$PORT_SERVER"
    elif port_in_use $PORT_SERVER; then
        echo_warning "Server        - Port in use but not responding"
    else
        echo_error "Server        - Not running"
    fi
    
    # Check Engine
    if pgrep -f "./engine" >/dev/null 2>&1; then
        local engine_pid=$(pgrep -f "./engine" | head -1)
        echo_success "Game Engine   - Running (PID: $engine_pid)"
    else
        echo_error "Game Engine   - Not running"
    fi
    
    # Check Vite
    if curl -s http://localhost:$PORT_VITE >/dev/null 2>&1; then
        echo_success "Vite          - Running on http://localhost:$PORT_VITE"
    elif port_in_use $PORT_VITE; then
        echo_warning "Vite          - Port in use but not responding"
    else
        echo_error "Vite          - Not running"
    fi
    
    echo ""
    echo "To view logs: dev attach <service-name>"
    echo "To stop all:  dev stop"
    echo ""
}

# Attach command
cmd_attach() {
    local service=$1
    
    if [ -z "$service" ]; then
        echo_error "Please specify a service to attach to"
        echo ""
        echo "Usage: dev attach <service>"
        echo ""
        echo "Available services:"
        echo "  mongodb   - MongoDB database"
        echo "  server    - Node.js Express server"
        echo "  engine    - Go simulation engine"
        echo "  vite      - Vite dev server"
        exit 1
    fi
    
    if ! session_exists; then
        echo_error "Development services not running"
        echo "Use 'dev start' first"
        exit 1
    fi
    
    # Map service name to window name
    local window_name=""
    case "$service" in
        mongodb|mongo)
            window_name="$WINDOW_MONGODB"
            ;;
        server|srv)
            window_name="$WINDOW_SERVER"
            ;;
        engine|eng|game)
            window_name="$WINDOW_ENGINE"
            ;;
        vite|client)
            window_name="$WINDOW_VITE"
            ;;
        *)
            echo_error "Unknown service '$service'"
            echo ""
            echo "Available services: mongodb, server, engine, vite"
            exit 1
            ;;
    esac
    
    # Check if window exists
    if ! tmux list-windows -t "$SESSION_NAME" 2>/dev/null | grep -q "^[0-9]*: $window_name"; then
        echo_error "Service '$service' window not found"
        echo "Available windows:"
        tmux list-windows -t "$SESSION_NAME" 2>/dev/null || true
        exit 1
    fi
    
    echo ""
    echo "Attaching to $service logs..."
    echo ""
    echo "Tip: Press Ctrl+B then D to detach (service keeps running)"
    echo "     Press Ctrl+C to stop the service"
    echo ""
    sleep 1
    
    # Attach to the window
    tmux attach -t "$SESSION_NAME:$window_name"
}

# Help command
cmd_help() {
    cat << EOF

SimCiv Development Environment Manager

Usage: dev <command> [options]

Commands:
  start     Start all development services
  stop      Stop all development services
  status    Show status of all services
  attach    Attach to a service's logs

Examples:
  dev start              Start all services
  dev stop               Stop all services
  dev status             Check what's running
  dev attach mongodb     View MongoDB logs
  dev attach server      View server logs
  dev attach engine      View engine logs
  dev attach vite        View Vite logs

Services:
  - MongoDB       Database (port $PORT_MONGODB)
  - Server        Node.js Express app (port $PORT_SERVER)
  - Engine        Go simulation engine
  - Vite          Client dev server with HMR (port $PORT_VITE)

All services run in a tmux session named '$SESSION_NAME'.
You can also use standard tmux commands:
  tmux attach -t $SESSION_NAME    Attach to session
  tmux list-windows -t $SESSION_NAME    List all windows

For more information, see designs/LOCAL_DEVELOPMENT_IMPROVEMENTS.md

EOF
}

# Main command dispatcher
case "${1:-}" in
    start)
        cmd_start
        ;;
    stop)
        cmd_stop
        ;;
    status)
        cmd_status
        ;;
    attach)
        cmd_attach "$2"
        ;;
    help|--help|-h)
        cmd_help
        ;;
    *)
        echo_error "Unknown command: ${1:-}"
        cmd_help
        exit 1
        ;;
esac
